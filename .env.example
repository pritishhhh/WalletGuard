# Copy only as a reference; scripts/init_local.py generates WG_DB_PASSWORD securely in ignored .env.
WG_PROFILE=local
WG_LOCAL_FUNDING=true
WG_ALLOWED_HOSTS=localhost,127.0.0.1,wallet-api
WG_CORS_ORIGINS=
# Native PostgreSQL: set DATABASE_URL and TEST_DATABASE_URL using generated local credentials.
# Production: inject WG_PRODUCTION_DATABASE_URL, WG_PRODUCTION_MIGRATION_URL,
# WG_PRODUCTION_HOSTS and optional WG_PRODUCTION_CORS_ORIGINS using your secrets manager.
